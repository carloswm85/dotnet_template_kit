{
    "$schema": "https://json.schemastore.org/template",
    "author": "Carlos W. Mercado",
    "classifications": [
        "Solution",
        "N-Layer",
        "API",
        "Web",
        "ASP.NET"
    ],
    "identity": "Clean.Architecture.Template.CSharp",
    "groupIdentity": "Clean.Architecture.Template",
    "name": "DTK Clean Architecture Template (C#)",
    "shortName": "dtk-clean-architecture",
    "sourceName": "CleanArchitectureTemplate",
    "defaultName": "CleanArchitectureProject",
    "tags": {
        "language": "C#",
        "type": "solution",
        "platform": "web"
    },
    "preferNameDirectory": true,
    "description": "A solution template implementing Clean Architecture.",
    "symbols": {
        "SolutionGuid": {
            "type": "generated",
            "generator": "guid",
            "replaces": "11111111-1111-1111-1111-111111111111"
        },
        "TargetFramework": {
            "type": "parameter",
            "datatype": "choice",
            "replaces": "{{TargetFramework}}",
            "defaultValue": "net10.0",
            "choices": [
                {
                    "displayName": ".NET 10.0 (LTS, Current Active)",
                    "choice": "net10.0"
                }
            ],
            "description": "The target framework for the projects."
        },
        "IncludeDocumentation": {
            "type": "parameter",
            "description": "Include explanatory documentation",
            "datatype": "bool",
            "defaultValue": "false"
        },
        "Hosts": {
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "Both",
            "choices": [
                {
                    "choice": "Both",
                    "displayName": "API and Web",
                    "description": "Generate the API and the Web projects."
                },
                {
                    "choice": "API",
                    "displayName": "API only",
                    "description": "Generate only the REST API project."
                },
                {
                    "choice": "Web",
                    "displayName": "Web only",
                    "description": "Generate only the MVC Web project. Set ApiBaseUrl to an external API."
                }
            ],
            "description": "The host projects to generate: API, Web, or Both."
        },
        "IncludeApi": {
            "type": "computed",
            "value": "(Hosts == \"API\" || Hosts == \"Both\")"
        },
        "IncludeWeb": {
            "type": "computed",
            "value": "(Hosts == \"Web\" || Hosts == \"Both\")"
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                "**/.vs/**",
                "**/.git/**",
                "**/.idea/**",
                "**/.vscode/**",
                "**/*.user",
                "**/*.suo",
                "**/.template.config/**",
                "**/*.cache",
                "**/.env",
                "**/appsettings.Development.json",
                "**/DataProtection-Keys/**",
                "**/wwwroot/uploads/**"
            ],
            "modifiers": [
                {
                    "condition": "(!IncludeApi)",
                    "exclude": [
                        "solution/CleanArchitectureTemplate.API/**",
                        "solution/tests/CleanArchitectureTemplate.Tests.Integration/API/**"
                    ]
                },
                {
                    "condition": "(!IncludeWeb)",
                    "exclude": [
                        "solution/CleanArchitectureTemplate.Web/**",
                        "solution/tests/CleanArchitectureTemplate.Tests.Integration/Web/**",
                        "solution/tests/CleanArchitectureTemplate.Tests.Integration/Controllers/**",
                        "solution/tests/CleanArchitectureTemplate.Tests.Integration/IntegrationWebApplicationFactory.cs"
                    ]
                }
            ]
        }
    ],
    "SpecialCustomOperations": {
        "**/.env.example": {
            "operations": [
                {
                    "type": "conditional",
                    "configuration": {
                        "if": ["#if"],
                        "else": ["#else"],
                        "elseif": ["#elseif"],
                        "endif": ["#endif"],
                        "trim": "true",
                        "wholeLine": "true",
                        "evaluator": "C++"
                    }
                }
            ]
        }
    },
    "primaryOutputs": [
        {
            "path": "./CleanArchitectureTemplate.slnx"
        }
    ],
    "postActions": [
        {
            "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
            "description": "Restore NuGet packages",
            "continueOnError": true,
            "args": {
                "files": "./CleanArchitectureTemplate.slnx"
            },
            "manualInstructions": [
                {
                    "text": "Run 'dotnet restore'"
                }
            ]
        }
    ]
}