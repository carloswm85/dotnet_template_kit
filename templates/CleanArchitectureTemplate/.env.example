# ==============================================================================
# Environment configuration for docker-compose
# ==============================================================================
# Setup:
#   1. Copy this file to `.env` (same folder as docker-compose.yml).
#   2. Replace every <my-...> placeholder with your own value.
#
# Notes:
#   - `.env` is ignored by Git and by Docker builds. Never commit it.
#   - Keep this file in source control with placeholder values only.
#   - Avoid spaces around `=`. Quote values only when required.
#   - Docker Compose reads `.env` automatically to fill ${...} values
#     in docker-compose.yml.
# ==============================================================================


# ==============================================================================
# ASP.NET Core
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development


# ==============================================================================
# Data Protection
# ==============================================================================
# Use a distinct name per app and environment, for example:
#   CleanArchitectureTemplate-Web-Development
#   CleanArchitectureTemplate-Web-Production
DataProtection__ApplicationName=CleanArchitectureTemplate-Web-Development


# ==============================================================================
# Local Docker SQL Server
# ==============================================================================
# SA password rules: at least 8 characters, with three of these four sets:
# uppercase, lowercase, digits and symbols.
MSSQL_SA_PASSWORD=<my-password>

# Must use the same password as MSSQL_SA_PASSWORD.
DOCKER_SQLSERVER_CONNECTION_STRING=Server=sqlserver,1433;Database=CleanArchitectureTemplateDb;User Id=sa;Password=<my-password>;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True;
