{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "ApplicationName": "CleanArchitectureTemplate"
  },
  "Hosting": {
    // Sub-path when hosted behind a reverse proxy, e.g. "/apps/web". Empty = root.
    "PathBase": "",
    "ForwardedHeaders": {
      // Enable behind a reverse proxy so the app sees the client IP and scheme.
      "Enabled": false,
      // Proxy IPs to trust. Empty trusts any source: use only on a private network.
      "KnownProxies": []
    }
  },
  "RateLimiting": {
    // Per client IP, for login, register, password reset and token refresh.
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US" ]
  }
}
