@using CleanArchitectureTemplate.ApplicationCore.Entities
@using CleanArchitectureTemplate.Infrastructure.Authorization.TestContactAuthorization
@using CleanArchitectureTemplate.Web.Models.ViewModels.TestContact

@model ContacListViewModel

@{
    ViewData["Title"] = "Contacts Management";
    int rowNumber = 1;
}
<div class="card my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">@ViewData["Title"]</h3>

        <!-- BUTTONS -->
        <div class="d-flex gap-2 col-12 col-md-12">
            <a asp-action="Create"
               role="button"
               class="btn btn-lg btn-primary flex-grow-1">
                <i class="bi bi-plus-circle me-2"></i>Create new contact
            </a>
        </div>
    </div>

    <div class="card-body">
                <div class="table-responsive">

                    <!-- RESULTS -->
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].Name)</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].Address)</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].City)</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].State)</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].Zip)</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].Email)</th>
                                <th>@Html.DisplayNameFor(model => model.TestContacts[0].Status)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.TestContacts)
                            {

                                var statusClass = item.Status switch
                                {
                                    TestContactStatus.Approved => "bg-success",
                                    TestContactStatus.Rejected => "bg-danger",
                                    TestContactStatus.Submitted => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td> @(rowNumber++) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Name) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Address) </td>
                                    <td> @Html.DisplayFor(modelItem => item.City) </td>
                                    <td> @Html.DisplayFor(modelItem => item.State) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Zip) </td>
                                    <td> @Html.DisplayFor(modelItem => item.Email) </td>
                                    <td>
                                        <span class="badge @statusClass">
                                            @Html.DisplayFor(modelItem => item.Status)
                                        </span>
                                    </td>

                                    <!-- BUTTONS -->
                                    <td class="d-flex">
                                        @if ((await AuthorizationService.AuthorizeAsync(
                                                                            User, item, TestContactOperations.Update)).Succeeded)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.TestContactId"
                                               class="btn btn-sm btn-outline-primary me-1">
                                                Edit
                                            </a>
                                        }

                                        <a asp-action="Details"
                                           asp-route-id="@item.TestContactId"
                                           class="btn btn-sm btn-outline-secondary me-1">
                                            Details
                                        </a>

                                        @if ((await AuthorizationService.AuthorizeAsync(
                                                                            User, item, TestContactOperations.Delete)).Succeeded)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@item.TestContactId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.TestContacts.Any())
                {
                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>No contacts found.
                    </div>
                }
    </div>
</div>
