@using CleanArchitectureTemplate.ApplicationCore.Entities
@using CleanArchitectureTemplate.Infrastructure.Authorization.TestContactAuthorization
@using CleanArchitectureTemplate.Web.Models.ViewModels.TestContact

@model TestContactViewModel

@{
    ViewData["Title"] = "Contact Details";

    var statusClass = Model.Status switch
    {
        TestContactStatus.Approved => "bg-success",
        TestContactStatus.Rejected => "bg-danger",
        TestContactStatus.Submitted => "bg-warning text-dark",
        _ => "bg-secondary"
    };


}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">@ViewData["Title"]</h3>
        <p class="text-muted mb-0">Contact information</p>
    </div>

    <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Name)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Address)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Address)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.City)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.City)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.State)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.State)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Zip)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Zip)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Email)
                    </dd>
                    <dt class="col-sm-4 text-muted">
                        Current Status
                    </dt>
                    <dd class="col-sm-8">
                        <span class="badge @statusClass">
                            @Html.DisplayFor(model => model.Status)
                        </span>
                    </dd>
                </dl>


                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <hr />

                    <!-- BUTTONS -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-bold text-muted me-1">
                            Action:
                        </span>

                        <span class="ms-auto">
                            @if (Model.Status != TestContactStatus.Approved)
                            {
                                @if ((await AuthorizationService.AuthorizeAsync(
                                                        User, Model.TestContact, TestContactOperations.Approve)).Succeeded)
                                {
                                    <form method="post" class="d-inline">
                                        <!-- HIDDEN_FIELDS -->
                                        <input type="hidden" name="id" value="@Model.TestContactId" />
                                        <input type="hidden"
                                           name="status"
                                           value="@TestContactStatus.Approved"/>
                                        <button type="submit" class="btn btn-success">
                                            <i class="bi bi-check-circle me-1"></i>Approve
                                        </button>
                                    </form>
                                }
                            }

                            @if (Model.Status != TestContactStatus.Rejected)
                            {
                                @if ((await AuthorizationService.AuthorizeAsync(
                                                        User, Model.TestContact, TestContactOperations.Reject)).Succeeded)
                                {
                                    <form method="post" class="d-inline">

                                        <!-- HIDDEN_FIELDS -->
                                        <input type="hidden" name="id" value="@Model.TestContactId" />
                                        <input type="hidden"
                                           name="status"
                                           value="@TestContactStatus.Rejected"/>

                                           <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-x-circle me-1"></i>Reject
                                        </button>
                                    </form>
                                }
                            }
                        </span>

                    </div>
                }


                <hr />

                <!-- BUTTONS -->
                <div class="d-flex flex-column flex-md-row gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-lg btn-outline-secondary flex-grow-1">
                        <i class="bi bi-arrow-left me-2"></i>Back to list
                    </a>

                    @if ((await AuthorizationService.AuthorizeAsync(
                                        User, Model.TestContact, TestContactOperations.Update)).Succeeded)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.TestContactId"
                           class="btn btn-lg btn-primary flex-grow-1">
                            <i class="bi bi-pencil-square me-2"></i>Edit
                        </a>
                    }
                </div>
    </div>
</div>
