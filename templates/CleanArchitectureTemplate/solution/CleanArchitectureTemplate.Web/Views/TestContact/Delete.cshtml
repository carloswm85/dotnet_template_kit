@model TestContactViewModel

@{
    ViewData["Title"] = "Delete Contact";
}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal text-danger my-3">@ViewData["Title"]</h3>
        <p class="text-muted mb-0">
            This action cannot be undone. Please confirm the contact details below.
        </p>
    </div>

    <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Name)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Address)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Address)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.City)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.City)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.State)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.State)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Zip)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Zip)
                    </dd>

                    <dt class="col-sm-4 text-muted">
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Email)
                    </dd>
                </dl>

                <hr />

                <form method="post" class="d-flex flex-column flex-md-row gap-2 pt-2">
                    <!-- HIDDEN_FIELDS -->
                    <input type="hidden" asp-for="TestContactId" />

                    <a asp-action="Index" class="btn btn-lg btn-outline-secondary flex-grow-1">
                        <i class="bi bi-arrow-left me-2"></i>Cancel
                    </a>

                    <button type="submit" class="btn btn-lg btn-danger flex-grow-1">
                        <i class="bi bi-trash me-2"></i>Delete contact
                    </button>
                </form>
    </div>
</div>
