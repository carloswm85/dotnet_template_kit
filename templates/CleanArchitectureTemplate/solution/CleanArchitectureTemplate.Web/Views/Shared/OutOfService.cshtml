@{
    Layout = "_OutOfServiceLayout";
    ViewData["Title"] = "Application out of service";
}

<main class="container d-flex align-items-center min-vh-100 py-4 py-md-5">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <section class="card border-0 shadow-lg rounded-4 overflow-hidden"
                     aria-labelledby="out-of-service-title"
                     aria-describedby="out-of-service-message">
                <div class="card-header border-0 bg-warning text-dark text-center py-4"
                     aria-hidden="true">
                    <i class="bi bi-tools display-4"></i>
                </div>

                <div class="card-body text-center p-4 p-md-5"
                     role="status"
                     aria-live="polite">
                    <h1 id="out-of-service-title" class="h2 fw-bold mb-3">
                        Application out of service
                    </h1>

                    <p id="out-of-service-message"
                       class="lead text-body-secondary mb-3">
                        The application is temporarily out of service.
                    </p>

                    <p class="text-body-secondary mb-4">
                        We are working to restore the service. Please try again
                        later.
                    </p>

                    <p class="small text-body-secondary mb-4">
                        This button opens the application once the service is
                        available again.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>
                        Check availability
                    </a>
                </div>
            </section>
        </div>
    </div>
</main>
