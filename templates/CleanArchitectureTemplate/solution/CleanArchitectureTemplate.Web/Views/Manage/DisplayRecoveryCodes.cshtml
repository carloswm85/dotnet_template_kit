@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model DisplayRecoveryCodesViewModel

@{
    ViewData["Title"] = "Your recovery codes";
}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-shield-lock me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">
        @if (!string.IsNullOrEmpty(ViewData["StatusMessage"] as string))
        {
            <div class="alert alert-success mb-4" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @ViewData["StatusMessage"]
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">New recovery codes were generated</h4>

        <hr />

        <div class="alert alert-info border-start border-4 border-secondary">
            <i class="bi bi-info-circle me-2"></i>
            Store these codes in a safe place. Each code can be used only once.
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2 mt-3" id="recoveryCodes">
            @foreach (var code in Model.Codes)
            {
                <div class="col">
                    <div class="border rounded px-3 py-2 text-center font-monospace recovery-code">
                        @code
                    </div>
                </div>
            }
        </div>

        <hr />

        <!-- BUTTONS -->
        <div class="d-flex flex-column flex-md-row gap-2 pt-2">
            <a asp-controller="Manage"
               asp-action="Index"
               class="btn btn-lg btn-outline-secondary flex-grow-1">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>

            <!-- BUTTONS -->
            <div class="d-flex flex-grow-1">
                <button type="button"
                        class="btn btn-lg btn-primary flex-grow-1"
                        id="saveCodesBtn">
                    <i class="bi bi-download me-1"></i>
                    Save as .txt
                </button>
            </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script type="module" src="~/js/recovery-codes.js"></script>
}
