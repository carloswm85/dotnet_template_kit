@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model SetPasswordViewModel

@{
    ViewData["Title"] = "Set password";
}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-key me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            You do not have a local username and password for this site. Add a local
            account so you can log in without an external provider.
        </div>

        <form asp-controller="Manage"
              asp-action="SetPassword"
              asp-route-returnurl="@ViewData["ReturnUrl"]"
              method="post"
              novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- NEW_PASSWORD -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- CONFIRM_PASSWORD -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <hr />

            <!-- BUTTONS -->
            <div class="d-grid pt-2">
                <button type="submit" class="btn btn-lg btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Set password
                </button>
            </div>
        </form>
        </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
