@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model IndexViewModel

@{
    ViewData["Title"] = "Manage your account";
}

<div class="card col-12 col-xl-10 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-person-gear me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(ViewData["StatusMessage"] as string))
            {
                <div class="alert alert-success">
                    @ViewData["StatusMessage"]
                </div>
            }


            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">User account settings</h5>
                </div>

                <ul class="list-group list-group-flush">

                    <!-- Password -->
                    <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <strong>Password</strong>
                        </div>
                        <!-- BUTTONS -->
                        <div>
                            @if (Model.HasPassword)
                            {
                                <a asp-controller="Manage"
                                   asp-action="ChangePassword"
                                   class="btn btn-sm btn-outline-primary">
                                    Change
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Manage"
                                   asp-action="SetPassword"
                                   class="btn btn-sm btn-outline-primary">
                                    Create
                                </a>
                            }
                        </div>
                    </li>

                    <!-- External Logins -->
                    <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <strong>External logins</strong>
                            <div class="text-muted small">
                                @Model.Logins.Count configured
                            </div>
                        </div>
                        <a asp-controller="Manage"
                           asp-action="ManageLogins"
                           class="btn btn-sm btn-outline-secondary">
                            Change
                        </a>
                    </li>

                    <!-- Phone Number -->
                    <li class="list-group-item">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <strong>Phone number</strong>
                                <div class="text-muted small">
                                    Used for two-factor authentication by SMS.
                                    See
                                    <a href="http://go.microsoft.com/fwlink/?LinkID=532713"
                                       target="_blank"
                                       rel="noopener">
                                        this article
                                        <i class="bi bi-box-arrow-in-up-right"
                                            aria-hidden="true"></i>
                                    </a>
                                    to set up this ASP.NET application.
                                </div>
                                <div class="mt-1">
                                    @(Model.PhoneNumber ?? "None")
                                </div>
                            </div>

                            <!-- BUTTONS -->
                            <div class="text-end">
                                @if (!String.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    <a asp-controller="Manage"
                                       asp-action="AddPhoneNumber"
                                       class="btn btn-sm btn-outline-primary mb-1">
                                        Change
                                    </a>

                                    <form asp-controller="Manage"
                                          asp-action="RemovePhoneNumber"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Remove
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Manage"
                                       asp-action="AddPhoneNumber"
                                       class="btn btn-sm btn-outline-primary">
                                        Add
                                    </a>
                                }
                            </div>
                        </div>
                    </li>

                    <!-- Two-Factor Authentication -->
                    <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <strong>Two-factor authentication</strong>
                            <div class="text-muted small">
                                @(Model.TwoFactor ? "Enabled" : "Disabled")
                            </div>
                        </div>

                        @if (Model.TwoFactor)
                        {
                            <form asp-controller="Manage"
                                  asp-action="DisableTwoFactorAuthentication"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    Disable
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Manage"
                                  asp-action="EnableTwoFactorAuthentication"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    Enable
                                </button>
                            </form>
                        }
                    </li>

                    <!-- Authenticator App -->
                    <li class="list-group-item">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <strong>Authenticator app</strong>

                                @if (Model.AuthenticatorKey != null)
                                {
                                    <div class="text-muted small mt-1">
                                        Key
                                    </div>
                                    <code class="d-block mt-1">
                                        @Model.AuthenticatorKey
                                    </code>
                                }
                            </div>

                            <div class="text-end">
                                @if (Model.AuthenticatorKey == null)
                                {
                                    <form asp-controller="Manage"
                                          asp-action="ResetAuthenticatorKey"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            Generate key
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Manage"
                                          asp-action="GenerateRecoveryCode"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Generate recovery codes
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </li>

                </ul>
            </div>

    </div>
</div>
