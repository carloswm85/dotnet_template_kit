@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model AddPhoneNumberViewModel

@{
    ViewData["Title"] = "Add phone number";
}


<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-telephone-plus me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">
                <form asp-controller="Manage"
                      asp-action="AddPhoneNumber"
                      method="post"
                      novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- PHONE_NUMBER -->
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               autocomplete="tel"
                               inputmode="tel"
                               placeholder="+1 555 123 4567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <hr />

                    <!-- BUTTONS -->
                    <div class="d-flex flex-column flex-md-row gap-2 pt-2">
                        <a asp-controller="Manage"
                           asp-action="Index"
                           class="btn btn-lg btn-outline-secondary flex-grow-1">
                            <i class="bi bi-arrow-left me-2"></i>Back
                        </a>

                        <button type="submit"
                                class="btn btn-lg btn-primary flex-grow-1">
                            <i class="bi bi-send me-2"></i>Send verification code
                        </button>
                    </div>
                </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
