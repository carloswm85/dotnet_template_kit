@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Manage

@model VerifyPhoneNumberViewModel

@{
    ViewData["Title"] = "Verify phone number";
}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-phone me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">
                    <p class="text-muted">
                        Enter the verification code sent to your phone number.
                    </p>

                    @if (ViewData["Status"] != null)
                    {
                        <div class="alert alert-info">
                            @ViewData["Status"]
                        </div>
                    }

                    <form asp-controller="Manage"
                          asp-action="VerifyPhoneNumber"
                          asp-route-returnurl="@ViewData["ReturnUrl"]"
                          method="post">

                        <!-- HIDDEN_FIELDS -->
                        <input asp-for="PhoneNumber" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- CODE -->
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label"></label>

                            <input asp-for="Code"
                                   class="form-control"
                                   autocomplete="one-time-code" />

                            <span asp-validation-for="Code"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- BUTTONS -->
                        <div class="d-grid pt-2">
                            <button type="submit"
                                    class="btn btn-lg btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Verify phone number
                            </button>
                        </div>

                    </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
