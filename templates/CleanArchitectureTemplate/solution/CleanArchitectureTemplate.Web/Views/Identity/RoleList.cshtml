@model List<ApplicationRole>

@{
    ViewData["Title"] = "Role management";
}

<div class="card my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-shield-lock-fill me-2"></i>@ViewData["Title"]
        </h3>

        <!-- BUTTONS -->
        <div class="d-flex gap-2 col-12 col-md-6 col-lg-4">
                <a asp-controller="Identity"
                   asp-action="RoleCreate"
                   class="btn btn-lg btn-primary flex-grow-1">
                    <i class="bi bi-plus-circle me-2"></i>Create new role
                </a>
        </div>
    </div>

    <div class="card-body">

            <!-- FLAG_INFORMATION -->
            <div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
                <h5 class="alert-heading d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    Role flag descriptions
                </h5>
                <hr />
                <div class="row g-3 small">
                    <div class="col-md-4">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <div>
                                <strong>Default</strong>
                                <p class="mb-0 text-muted">Assigned automatically to new users at registration. Does not affect visibility.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-eye-fill text-primary mt-1"></i>
                            <div>
                                <strong>Public</strong>
                                <p class="mb-0 text-muted">Visible to non-admin users in self-service and profile pages. Does not affect assignment.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-lock-fill text-warning mt-1"></i>
                            <div>
                                <strong>Static</strong>
                                <p class="mb-0 text-muted">System role created during seeding. It cannot be deleted and renaming is restricted.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-check me-2"></i>Roles existentes
                    </h5>
                </div>

                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <!-- RESULTS -->
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Id</th>
                                        <th scope="col">Role name</th>
                                        <th scope="col" class="text-center">Default</th>
                                        <th scope="col" class="text-center">Public</th>
                                        <th scope="col" class="text-center">Static</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var role in Model)
                                    {
                                        <tr>
                                            <td class="text-muted small">@role.Id</td>

                                            <td class="fw-semibold">
                                                <i class="bi bi-shield me-1 text-secondary"></i>
                                                @role.Name
                                            </td>

                                            <td class="text-center">
                                                @if (role.IsDefault)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success"
                                                       data-bs-toggle="tooltip"
                                                       title="Assigned to new users"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-danger"
                                                       data-bs-toggle="tooltip"
                                                       title="Not assigned"></i>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @if (role.IsPublic)
                                                {
                                                    <i class="bi bi-eye-fill text-primary"
                                                       data-bs-toggle="tooltip"
                                                       title="Visible in the interface"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-danger"
                                                       data-bs-toggle="tooltip"
                                                       title="Not assigned"></i>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @if (role.IsStatic)
                                                {
                                                    <i class="bi bi-lock-fill text-warning"
                                                       data-bs-toggle="tooltip"
                                                       title="System role"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-danger"
                                                       data-bs-toggle="tooltip"
                                                       title="Not assigned"></i>
                                                }
                                            </td>

                                            <td>
                                                <!-- BUTTONS -->
                                                <div class="d-flex flex-wrap gap-2">

                                                    @if (role.IsStatic)
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                disabled
                                                                data-bs-toggle="tooltip"
                                                       title="Static roles cannot be edited or deleted">
                                                            <i class="bi bi-lock"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="RoleEdit"
                                                           asp-route-id="@role.Id"
                                                           class="btn btn-sm btn-outline-primary"
                                                           data-bs-toggle="tooltip"
                                                           title="Edit role">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>
                                                        <a asp-action="RoleDelete"
                                                           asp-route-id="@role.Id"
                                                           class="btn btn-sm btn-outline-danger"
                                                           data-bs-toggle="tooltip"
                                                           title="Delete role">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning m-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>No roles defined
                        </div>
                    }
                </div>
            </div>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_BootstrapTooltips")
}
