@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Identity

@model UserViewModel

@{
    ViewData["Title"] = "Delete user";
}

<div class="card col-12 col-xl-9 mx-auto my-3">


    @if (Model == null)
    {
        <div class="card-body">
            <div class="alert alert-warning mb-0">User not found.</div>
        </div>
        return;
    }

    else
    {
        <div class="card-header pb-3">
            <h3 class="fw-normal text-danger my-3">
                <i class="bi bi-person-x me-2"></i>@ViewData["Title"]
            </h3>
        </div>

        <div class="card-body">
                <div class="alert alert-danger border-danger shadow-sm" role="alert">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                        <div>
                            <h4 class="alert-heading mb-1">Confirm user deletion</h4>
                            <p class="mb-0">Are you sure you want to delete this user? This action cannot be undone.</p>
                        </div>
                    </div>
                </div>

                <!-- Image Preview (Default or Existing) -->
                <div class="mb-3 text-center">
                    <img id="previewImage"
                         src="@(string.IsNullOrEmpty(Model.ImagePath)
                                    ? Url.Content("~/images/defaults/default-person.png")
                                    : Url.Content(Model.ImagePath))"
                         alt="User profile"
                         class="img-thumbnail"
                         style="max-width: 150px;" />
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-person-x me-2"></i>User information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="border-start border-danger border-4 ps-3">
                                    <h6 class="text-muted mb-1">Username</h6>
                                    <p class="mb-0 fw-semibold">@Model.UserName</p>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border-start border-danger border-4 ps-3">
                                    <h6 class="text-muted mb-1">Full name</h6>
                                    <p class="mb-0 fw-semibold">@Model.FullName</p>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border-start border-danger border-4 ps-3">
                                    <h6 class="text-muted mb-1">Status</h6>
                                    <p class="mb-0">
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-x-circle me-1"></i>Inactive
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border-start border-danger border-4 ps-3">
                                    <h6 class="text-muted mb-1">Email</h6>
                                    <p class="mb-0">
                                        @if (!string.IsNullOrEmpty(Model.Email))
                                        {
                                            <span>@Model.Email</span>
                                            @if (Model.EmailConfirmed)
                                            {
                                                <i class="bi bi-check-circle-fill text-success ms-1"
                                                    title="Verified"></i>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not provided</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border-start border-danger border-4 ps-3">
                                    <h6 class="text-muted mb-1">Phone number</h6>
                                    <p class="mb-0">
                                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                        {
                                            <span>@Model.PhoneNumber</span>
                                            @if (Model.PhoneNumberConfirmed)
                                            {
                                                <i class="bi bi-check-circle-fill text-success ms-1"
                                                    title="Verified"></i>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not provided</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            @if (Model.Roles != null && Model.Roles.Any())
                            {
                                <div class="col-12">
                                    <div class="border-start border-danger border-4 ps-3">
                                        <h6 class="text-muted mb-2">Assigned roles</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var role in Model.Roles)
                                            {
                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-person-badge me-1"></i>@role
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (Model.Claims != null && Model.Claims.Any())
                            {
                                <div class="col-12">
                                    <div class="border-start border-danger border-4 ps-3">
                                        <h6 class="text-muted mb-2">Assigned claims</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var claim in Model.Claims)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-key-fill me-1"></i>@claim
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card border-warning mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-info-circle-fill text-warning fs-4 me-3 mt-1"></i>
                            <div>
                                <h6 class="mb-2">What happens when this user is deleted?</h6>
                                <ul class="mb-0 small">
                                    <li>The user account is permanently removed from the system</li>
                                    <li>All associated roles and claims are removed</li>
                                    <li>The user can no longer log in</li>
                                    <li>This action cannot be reverted</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="UserDelete" asp-route-id="@Model.Id" method="post">
                    <div class="card">
                        <div class="card-body">
                            <!-- BUTTONS -->
                            <div class="d-flex flex-column flex-md-row gap-2">
                                <a asp-action="UserList"
                                   class="btn btn-outline-secondary btn-lg flex-grow-1">
                                    <i class="bi bi-arrow-left me-2"></i>No, keep the user
                                </a>
                                <button type="submit" class="btn btn-danger btn-lg flex-grow-1">
                                    <i class="bi bi-trash me-2"></i>Yes, delete the user
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="UserDetails"
                       asp-route-id="@Model.Id"
                       class="text-muted text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>View user details
                    </a>
                </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const img = document.getElementById("previewImage");

            if (img) {
                img.addEventListener("error", function () {
                    this.src = '/images/defaults/default-person.png';
                });
            }
        });
    </script>
}
