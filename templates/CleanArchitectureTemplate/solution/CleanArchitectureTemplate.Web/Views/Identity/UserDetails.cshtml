@using CleanArchitectureTemplate.Web.Controllers.Identity
@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Identity

@model UserViewModel

@{
    ViewData["Title"] = "User details";
    string roleBg = "";
    bool isLockedOut = Model?.LockoutEnd != null && Model.LockoutEnd > DateTimeOffset.UtcNow;
}

<div class="card my-3">

    @if (Model == null)
    {
        <div class="card-body">
            <div class="alert alert-warning mb-0">User not found.</div>
        </div>
    }

    else
    {
        <div class="card-header pb-3">
            <h3 class="fw-normal my-3">
                <i class="bi bi-person-circle me-2"></i>@ViewData["Title"]
            </h3>

            <!-- BUTTONS -->
            <div class="d-flex flex-column flex-md-row gap-2">
                <a asp-action="UserList" class="btn btn-lg btn-outline-light flex-grow-1">
                    <i class="bi bi-arrow-left me-2"></i>Back to list
                </a>

                <a asp-action="UserEdit"
                   asp-route-id="@Model.Id"
                   class="btn btn-lg btn-primary flex-grow-1">
                    <i class="bi bi-pencil-square me-2"></i>Edit user
                </a>

                <a asp-action="UserRolesEdit"
                   asp-route-id="@Model.Id"
                   class="btn btn-lg btn-primary flex-grow-1">
                    <i class="bi bi-person-gear me-2"></i>Edit roles
                </a>
            </div>
        </div>

        <div class="card-body">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">@Model.FullName</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">

                            <!-- ===================== PROFILE IMAGE ===================== -->
                            <div class="col-md-6 d-flex align-items-center justify-content-center text-center">
                                <!-- Image Preview (Default or Existing) -->
                                <div class="text-center mb-4">
                                    <img src="@(string.IsNullOrEmpty(Model.ImagePath)
                                            ? Url.Content("~/images/defaults/default-person.png")
                                            : Url.Content(Model.ImagePath))"
                                         alt="User profile"
                                         class="img-thumbnail"
                                         style="max-width: 180px;" />
                                </div>
                            </div>

                            <!-- ===================== BASIC INFORMATION ===================== -->
                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-info-circle me-2"></i>Basic information
                                    </h6>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Username:</dt>
                                        <dd class="col-sm-7">@Model.UserName</dd>

                                        <dt class="col-sm-5">Full name:</dt>
                                        <dd class="col-sm-7">@Model.FullName</dd>


                                        <dt class="col-sm-5">Status:</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>Inactive
                                                </span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- ===================== CONTACT INFORMATION ===================== -->
                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-envelope me-2"></i>Contact information
                                    </h6>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Email:</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.Email))
                                            {
                                                <span>@Model.Email</span>
                                                @if (Model.EmailConfirmed)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success ms-1"
                                                        title="Verified"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-exclamation-circle-fill text-warning ms-1"
                                                        title="Not verified"></i>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Not provided</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Phone number:</dt>
                                        <dd class="col-sm-7">
                                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                            {
                                                <span>@Model.PhoneNumber</span>
                                                @if (Model.PhoneNumberConfirmed)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success ms-1"
                                                        title="Verified"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-exclamation-circle-fill text-warning ms-1"
                                                        title="Not verified"></i>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Not provided</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- ====================== SECURITY SETTINGS ====================== -->
                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-shield-lock me-2"></i>Security settings
                                    </h6>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-6">Two-factor authentication:</dt>
                                        <dd class="col-sm-6">
                                            @if (Model.TwoFactorEnabled)
                                            {
                                                <span class="badge bg-success">Enabled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Disabled</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-6">Lockout enabled:</dt>
                                        <dd class="col-sm-6">
                                            @if (Model.LockoutEnabled)
                                            {
                                                <span class="badge bg-warning text-dark">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-6">Lockout status:</dt>
                                        <dd class="col-sm-6">
                                            @if (isLockedOut)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-lock-fill me-1"></i>Locked out until @Model.LockoutEnd!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                </span>
                                                <form asp-action="UserUnlock"
                                                      asp-route-id="@Model.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    <input type="hidden" name="returnTo" value="@nameof(IdentityController.UserDetails)" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger mt-1"
                                                            onclick="return confirm('Unlock this account? The failed attempt count is also reset.');">
                                                        <i class="bi bi-unlock me-1"></i>Unlock
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-unlock me-1"></i>Not locked
                                                </span>
                                            }
                                            @if (TempData[IdentityController.LockoutMessageKey] is string lockoutMessage)
                                            {
                                                <small class="text-success d-block mt-1">@lockoutMessage</small>
                                            }
                                            @if (TempData[IdentityController.LockoutErrorKey] is string lockoutError)
                                            {
                                                <small class="text-danger d-block mt-1">@lockoutError</small>
                                            }
                                        </dd>

                                        <dt class="col-sm-6">Failed attempts:</dt>
                                        <dd class="col-sm-6">
                                            <span class="badge @(Model.AccessFailedCount > 0 ? "bg-warning text-dark" : "bg-secondary")">
                                                @Model.AccessFailedCount
                                            </span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- ============================ ROLES ============================ -->
                            <div class="col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-people me-2"></i>Roles
                                    </h6>
                                    @if (Model.Roles != null && Model.Roles.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">


                                            @foreach (var role in Model.Roles)
                                            {
                                                switch (role)
                                                {
                                                    default:
                                                        roleBg = "bg-info";
                                                        break;
                                                }

                                                <span class="badge @roleBg text-dark">
                                                    <i class="bi bi-person-badge me-1"></i>@role
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted fst-italic mb-0">No roles assigned</p>
                                    }
                                </div>
                            </div>

                            <!-- =========================== CLAIMS ============================ -->
                            <div class="col-md-6">
                                <div class="border rounded p-3">
                                    <h6 class="text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-key me-2"></i>Claims
                                    </h6>
                                    @if (Model.Claims != null && Model.Claims.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var claim in Model.Claims)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-key-fill me-1"></i>@claim
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted fst-italic mb-0">No claims assigned</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =========================== FOOTER ============================ -->
                    <div class="card-footer text-muted d-flex justify-content-between align-items-center">
                        <small class="ms-auto">
                            <i class="bi bi-calendar me-1"></i>Last updated: @DateTime.Now.ToString("g")
                        </small>
                    </div>
                </div>
        </div>
    }

</div>
