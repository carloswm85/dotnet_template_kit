@using CleanArchitectureTemplate.Web.Models
@using CleanArchitectureTemplate.Web.Models.ViewModels.Identity.Identity

@model PaginatedListViewModel<_UserListItemViewModel>

@{
    ViewData["Title"] = "User list";
    bool lockedOnly = ViewData["LockedOnly"] as bool? ?? false;
    // null drops the route value, so the URL stays clean when the filter is off
    string? lockedOnlyRoute = lockedOnly ? "true" : null;
}

<div class="card my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-people-fill me-2"></i>@ViewData["Title"]
        </h3>

        <!-- BUTTONS -->
        <div class="d-flex gap-2 col-12 col-md-6 col-lg-4">
                <a asp-controller="Identity"
                   asp-action="UserCreate"
                   class="btn btn-lg btn-primary flex-grow-1">
                    <i class="bi bi-plus-circle me-2"></i>Create new user
                </a>
        </div>
    </div>

    <div class="card-body">

            <div class="row g-3 mb-4">
                <!-- SEARCH -->
                <div class="col-12 col-xl-8">
                    <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-search me-2"></i>Search
                    </h5>
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-3">

                        <!-- Page Size -->
                        <div>
                            <label for="PageSize" class="form-label fw-semibold">
                                Page size
                            </label>

                            <select id="PageSize"
                                    class="form-select w-auto"
                                    onchange="location = this.value;">

                                @{
                                    int[] sizes = new[] { 5, 10, 25, 50, 100 };
                                }

                                @foreach (var size in sizes)
                                {
                                    string? url = Url.Action("UserList", new
                                    {
                                        currentFilter = Model.CurrentFilter,
                                        pageIndex = 1,
                                        pageSize = size,
                                        searchString = Model.CurrentFilter,
                                        sortOrder = Model.CurrentSort,
                                        lockedOnly = lockedOnlyRoute
                                    });

                                    if (Model.PageSize == size)
                                    {
                                        <option value="@url" selected>@size</option>
                                    }
                                    else
                                    {
                                        <option value="@url">@size</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Search -->
                        <form asp-action="UserList" method="get">
                            <div class="row g-2 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label fw-semibold">
                                        Search
                                    </label>

                                    <!-- BUTTONS -->
                                    <div class="input-group">
                                        <!-- HIDDEN_FIELDS -->
                                        <input type="hidden"
                                           name="sortOrder"
                                           value="@Model.CurrentSort"/>
                                        <input type="hidden" name="pageIndex" value="1" />
                                        @if (lockedOnly)
                                        {
                                            <input type="hidden" name="lockedOnly" value="true" />
                                        }
                                        <input type="hidden"
                                           name="pageSize"
                                           value="@Model.PageSize"/>

                                        <input type="text"
                                               name="SearchString"
                                               value="@Model.CurrentFilter"
                                               class="form-control rounded-1"
                                               placeholder="Name or username" />

                                        @if (!string.IsNullOrWhiteSpace(Model.CurrentFilter))
                                        {
                                            <a asp-action="UserList"
                                               asp-route-sortOrder="@Model.CurrentSort"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-lockedOnly="@lockedOnlyRoute"
                                               class="btn btn-outline-secondary">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        }
                                    </div>
                                </div>

                                <!-- BUTTONS -->
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i>Search
                                    </button>
                                </div>

                                <!-- BUTTONS -->
                                <div class="col-auto">
                                    <a asp-action="UserList" class="btn btn-secondary">
                                        Reset
                                    </a>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
                    </div>
                </div>

                <!-- FILTERS -->
                <div class="col-12 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="bi bi-funnel-fill me-2"></i>Quick filters
                            </h5>
                        </div>

                        <div class="card-body d-flex align-items-center">
                            <div class="d-flex flex-wrap gap-2">
                                <!-- LOCKED_ONLY toggle -->
                                <div class="col-auto">
                                    <a asp-action="UserList"
                                       asp-route-pageIndex="1"
                                       asp-route-currentFilter="@Model.CurrentFilter"
                                       asp-route-searchString="@Model.CurrentFilter"
                                       asp-route-sortOrder="@Model.CurrentSort"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-lockedOnly="@(lockedOnly ? null : "true")"
                                       class="btn @(lockedOnly ? "btn-danger" : "btn-outline-danger")"
                                       aria-pressed="@(lockedOnly ? "true" : "false")">
                                        <i class="bi bi-lock-fill me-1"></i>Locked out only
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Empty State -->
            @if (!Model.PaginatedList.Any())
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    No users found.
                </div>
            }
            else
            {
                <!-- RESULTS -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-table me-2"></i>User list
                        </h5>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <!-- RESULTS -->
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="align-middle">
                                        <th>#</th>
                                        <th>
                                            <a asp-action="UserList"
                                               asp-route-sortOrder="@Model.SortColumnOne"
                                               asp-route-pageIndex="@Model.PaginatedList.PageIndex"
                                               asp-route-currentFilter="@Model.CurrentFilter"
                                               asp-route-searchString="@Model.CurrentFilter"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-lockedOnly="@lockedOnlyRoute">
                                                @Html.DisplayNameFor(model => model.PaginatedList[0].LastName)
                                            </a>
                                        </th>
                                        <th> @Html.DisplayNameFor(model => model.PaginatedList[0].FirstName) </th>
                                        <th>
                                            <a asp-action="UserList"
                                               asp-route-sortOrder="@Model.SortColumnTwo"
                                               asp-route-pageIndex="@Model.PaginatedList.PageIndex"
                                               asp-route-currentFilter="@Model.CurrentFilter"
                                               asp-route-searchString="@Model.CurrentFilter"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-lockedOnly="@lockedOnlyRoute">
                                                @Html.DisplayNameFor(model => model.PaginatedList[0].UserName)
                                            </a>
                                        </th>
                                        <th>@Html.DisplayNameFor(model => model.PaginatedList[0].Roles)</th>
                                        <th>@Html.DisplayNameFor(model => model.PaginatedList[0].IsActive)</th>
                                        <th>@Html.DisplayNameFor(model => model.PaginatedList[0].EmailConfirmed)</th>
                                        <th>Lockout</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @{
                                        int rowNumber = 1;
                                    }

                                    @foreach (var item in Model.PaginatedList)
                                    {
                                        <tr>
                                            <td><b>@(rowNumber++)</b></td>
                                            <td>@item.LastName</td>
                                            <td>@item.FirstName</td>

                                            <td>
                                                <strong>@item.UserName</strong>
                                                @if (item.LockoutEnd != null && item.LockoutEnd > DateTimeOffset.UtcNow)
                                                {
                                                    <i class="bi bi-lock-fill text-danger ms-1"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Locked out until @item.LockoutEnd.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")"></i>
                                                }
                                                @if (item.Email != item.UserName)
                                                {
                                                    <div class="text-muted small">@item.Email</div>
                                                }

                                            </td>

                                            <td>
                                                @if (!item.Roles.Any())
                                                {
                                                    <span class="text-muted fst-italic">—</span>
                                                }
                                                else
                                                {
                                                    <div>
                                                        @foreach (var role in item.Roles.OrderBy(r => r, StringComparer.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-info text-dark me-1 mb-1">@role</span>
                                                        }
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                                    @(item.IsActive ? "Yes" : "No")
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge @(item.EmailConfirmed ? "bg-success" : "bg-secondary")">
                                                    @(item.EmailConfirmed ? "Yes" : "No")
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge @(item.LockoutEnabled ? "bg-warning" : "bg-secondary")">
                                                    @(item.LockoutEnabled ? "Enabled" : "Disabled")
                                                </span>
                                                <br />
                                                @{
                                                    bool isLockedOut = item.LockoutEnd != null && item.LockoutEnd > DateTimeOffset.UtcNow;
                                                }
                                                <span class="badge @(isLockedOut ? "bg-danger" : "bg-secondary")">
                                                    @(isLockedOut ? "Locked out" : "Not locked")
                                                </span>
                                            </td>

                                            <td>
                                                <!-- BUTTONS -->
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a asp-action="UserEdit"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-primary"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Edit user">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>

                                                    <a asp-action="UserDetails"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-info"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="View user details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <a asp-action="UserDelete"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-danger"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Delete user">
                                                        <i class="bi bi-trash"></i>
                                                    </a>

                                                    <a asp-action="UserRolesEdit"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-secondary"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       data-bs-title="Edit user roles">
                                                        <i class="bi bi-person-gear"></i>
                                                    </a>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- PAGINATION -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <!-- PAGINATION -->
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.PaginatedList.PageIndex == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="1"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-searchString="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-lockedOnly="@lockedOnlyRoute">
                                    First
                                </a>
                            </li>

                            <li class="page-item @(Model.PaginatedList.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="@(Model.PaginatedList.PageIndex - 1)"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-searchString="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-lockedOnly="@lockedOnlyRoute">
                                    Previous
                                </a>
                            </li>

                            <li class="page-item disabled">
                                <span class="page-link">
                                    Page @Model.PaginatedList.PageIndex of @Model.PaginatedList.TotalPages
                                </span>
                            </li>

                            <li class="page-item @(Model.PaginatedList.HasNextPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="@(Model.PaginatedList.PageIndex + 1)"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-searchString="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-lockedOnly="@lockedOnlyRoute">
                                    Next
                                </a>
                            </li>

                            <li class="page-item @(Model.PaginatedList.PageIndex == Model.PaginatedList.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="UserList"
                                   asp-route-pageIndex="@Model.PaginatedList.TotalPages"
                                   asp-route-currentFilter="@Model.CurrentFilter"
                                   asp-route-searchString="@Model.CurrentFilter"
                                   asp-route-sortOrder="@Model.CurrentSort"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-lockedOnly="@lockedOnlyRoute">
                                    Last
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <div class="text-muted">
                        <i class="bi bi-bar-chart-fill me-1"></i>
                        <strong>@Model.PaginatedList.TotalRecords</strong> total,
                        <strong>@Model.PaginatedList.FilteredCount</strong> filtered,
                        <strong>@Model.PaginatedList.Count</strong> shown
                    </div>
                </div>
            }

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_BootstrapTooltips")
}
