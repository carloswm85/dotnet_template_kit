@using CleanArchitectureTemplate.ApplicationCore.Dtos.ContosoUniversity
@model IEnumerable<TestEnrollmentDateGroupDto>

@{
    ViewData["Title"] = "Student Body Statistics";
}

<div class="card my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">@ViewData["Title"]</h3>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nº</th>
                <th>Enrollment Year</th>
                <th>Students</th>
            </tr>
        </thead>
        <tbody>
            @{
                int row = 0;
            }
            @foreach (var item in Model)
            {
                row++;
                <tr>
                    <td>@row</td>
                    <td>@Html.DisplayFor(modelItem => item.TestEnrollmentYear)</td>
                    <td>@item.TestStudentCount</td>
                </tr>
            }
        </tbody>
            </table>
        </div>
    </div>
</div>
