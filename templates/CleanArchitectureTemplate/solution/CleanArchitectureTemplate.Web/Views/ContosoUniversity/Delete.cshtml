@using CleanArchitectureTemplate.ApplicationCore.Dtos.ContosoUniversity
@model TestStudentDto

@{
    ViewData["Title"] = "Delete Student";
}

<div class="my-3">

    @if (Model == null)
    {
        <div class="alert alert-warning">User not found.</div>
    }

    else
    {
        <div class="card col-12 col-lg-9 mx-auto">
            <div class="card-header pb-3">
                <h3 class="fw-normal text-danger my-3">@ViewData["Title"]</h3>
                <p class="text-danger mb-0">@ViewData["ErrorMessage"]</p>
            </div>

            <div class="card-body">
                        <h5 class="text-danger mb-4">Are you sure you want to delete this student?</h5>

                        <!-- Image Preview (Default or Existing) -->
                        <div class="mb-3 text-center">
                            <img id="previewImage"
                                 src="@(string.IsNullOrEmpty(Model?.ImagePath)
                                                                                                  ? Url.Content("~/images/defaults/default-person.png")
                                                                                                  : Url.Content(Model.ImagePath))"
                                 alt="Student profile"
                                 class="img-thumbnail"
                                 style="max-width: 150px;" />
                        </div>

                        <dl class="row">
                            <dt class="col-sm-4 fw-semibold text-secondary">
                                @Html.DisplayNameFor(model => model.LastName)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.LastName)
                            </dd>

                            <dt class="col-sm-4 fw-semibold text-secondary">
                                @Html.DisplayNameFor(model => model.FirstMidName)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.FirstMidName)
                            </dd>

                            <dt class="col-sm-4 fw-semibold text-secondary">
                                @Html.DisplayNameFor(model => model.TestEnrollmentDate)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.TestEnrollmentDate)
                            </dd>
                        </dl>

                        <hr />

                        <form asp-controller="ContosoUniversity"
                           asp-action="delete"
                           asp-route-id="@Model!.Id"
                           class="mt-4">

                            <!-- HIDDEN_FIELDS -->
                            <input type="hidden" asp-for="Id" />

                            <!-- BUTTONS -->
                            <div class="d-flex flex-column flex-md-row gap-2 pt-2">
                                <a asp-controller="ContosoUniversity"
                                   asp-action="list"
                                   class="btn btn-lg btn-outline-secondary flex-grow-1">
                                    <i class="bi bi-arrow-left me-2"></i>Back to List
                                </a>
                                <button type="submit" class="btn btn-lg btn-danger flex-grow-1">
                                    <i class="bi bi-trash me-2"></i>Confirm Delete
                                </button>
                            </div>
                        </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const img = document.getElementById("previewImage");

            if (img) {
                img.addEventListener("error", function () {
                    this.src = '/images/defaults/default-person.png';
                });
            }
        });
    </script>
}
