@using CleanArchitectureTemplate.ApplicationCore.Dtos.ContosoUniversity
@model TestStudentDto

@{
    ViewData["Title"] = "Student Details";
}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-person-fill me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">

            <!-- Image Preview (Default or Existing) -->
            <div class="text-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model?.ImagePath)
                        ? Url.Content("~/images/defaults/default-person.png")
                        : Url.Content(Model.ImagePath))"
                    alt="Student profile"
                    class="img-thumbnail"
                    style="max-width: 180px;" />
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 fw-semibold text-secondary">
                    @Html.DisplayNameFor(model => model.LastName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.LastName)
                </dd>

                <dt class="col-sm-3 fw-semibold text-secondary">
                    @Html.DisplayNameFor(model => model.FirstMidName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.FirstMidName)
                </dd>

                <dt class="col-sm-3 fw-semibold text-secondary">
                    @Html.DisplayNameFor(model => model.GovernmentIdFormatted)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.GovernmentIdFormatted)
                </dd>

                <dt class="col-sm-3 fw-semibold text-secondary">
                    @Html.DisplayNameFor(model => model.TestEnrollmentDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.TestEnrollmentDate)
                </dd>
            </dl>

            <hr />

            <h5 class="mt-4 mb-3">
                <i class="bi bi-book-fill me-2"></i> Enrollments
            </h5>

            @if (Model!.TestEnrollments == null || Model.TestEnrollments.Count <= 0)
            {
                <div class="alert alert-info" role="alert">
                    <ul class="m-0">
                        <li>No enrollments to display.</li>
                    </ul>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Course Title</th>
                                <th>Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.TestEnrollments)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.TestCourse!.Title)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Grade)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    <div class="card-footer">
        <!-- BUTTONS -->
        <div class="d-flex flex-column flex-md-row gap-2 py-2">
            <a asp-controller="ContosoUniversity"
               asp-action="list"
               class="btn btn-lg btn-outline-secondary flex-grow-1">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
            <a asp-controller="ContosoUniversity"
               asp-action="edit"
               asp-route-id="@Model.Id"
               class="btn btn-lg btn-primary flex-grow-1">
                <i class="bi bi-pencil-square me-2"></i>Edit
            </a>
        </div>
    </div>
</div>
