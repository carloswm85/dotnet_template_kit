@using CleanArchitectureTemplate.ApplicationCore.Dtos.ContosoUniversity
@using CleanArchitectureTemplate.Web.Models
@model PaginatedListViewModel<TestStudentDto>

@{
    ViewData["Title"] = "TestStudents Management";
}

<div class="card my-3">
    <!-- Header Row -->
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">@ViewData["Title"]</h3>

        <!-- BUTTONS -->
        <div class="d-flex gap-2 col-12 col-md-12">
            <a asp-controller="ContosoUniversity"
               asp-action="create"
               role="button"
               class="btn btn-lg btn-primary flex-grow-1">
                <i class="bi bi-plus-circle me-2"></i>Create New
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-between flex-wrap gap-3">
        <!-- Page Size Dropdown -->
        <div class="mb-4">
            <label for="PageSize" class="form-label fw-semibold">Page Size:</label>

            <select id="PageSize"
                    class="form-select d-inline-block w-auto"
                    onchange="location = this.value;">

                @{
                    int[] sizes = new[] { 5, 10, 25, 50, 100 };
                }

                @foreach (var size in sizes)
                {
                    string? url = @Url.Action("Index", new
                    {
                        currentFilter = Model.CurrentFilter,
                        pageIndex = 1,
                        pageSize = size,
                        searchString = Model.CurrentFilter,
                        sortOrder = Model.CurrentSort,
                    });

                    if (Model.PageSize == size)
                    {
                        <option selected value="@url"> @size </option>
                    }
                    else
                    {
                        <option value="@url"> @size </option>
                    }
                }
            </select>
        </div>

        <!-- Search Form -->
        <form asp-action="Index" method="get" class="mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <!-- BUTTONS -->
                    <div class="input-group">
                        <!-- HIDDEN_FIELDS -->
                        <input type="hidden" name="sortOrder" value="@Model.CurrentSort" />
                        <input type="hidden" name="pageIndex" value="1" /> <!-- reset to page 1 on search -->
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <input type="text"
                               id="SearchString"
                               name="SearchString"
                               value="@Model.CurrentFilter"
                               class="form-control
                                    @(string.IsNullOrEmpty(Convert.ToString(Model.CurrentFilter))
                                                                       ? "rounded-1" : "rounded-start-2")"
                               placeholder="Enter name..." />

                        @if (!string.IsNullOrEmpty(Convert.ToString(Model.CurrentFilter)))
                        {
                            <a asp-action="Index"
                               asp-route-sortOrder="@Model.CurrentSort"
                               asp-route-pageIndex="@(Model.PaginatedList.PageIndex)"
                               asp-route-currentFilter=""
                               asp-route-pageSize="@Model.PageSize"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <!-- BUTTONS -->
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </div>

                <!-- BUTTONS -->
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-secondary">
                        Reset Default
                    </a>
                </div>

            </div>
        </form>
        </div>

    <!-- No Data Warning -->
    @if (!Model.PaginatedList.Any())
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            There is no data to display.
        </div>
    }
    else
    {
        <!-- RESULTS -->
        <!-- BUTTONS -->
        <div class="table-responsive mb-4">
            <!-- RESULTS -->
            <table class="table table-striped table-hover mb-0 align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@Model.SortColumnOne"
                                       asp-route-pageIndex="@(Model.PaginatedList.PageIndex)"
                                       asp-route-currentFilter="@Model.CurrentFilter"
                                       asp-route-searchString="@Model.CurrentFilter"
                                       asp-route-pageSize="@Model.PageSize">
                                        @Html.DisplayNameFor(model => model.PaginatedList[0].LastName)
                                    </a>
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.PaginatedList[0].FirstMidName)
                                </th>

                                <th>
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@Model.SortColumnTwo"
                                       asp-route-pageIndex="@(Model.PaginatedList.PageIndex)"
                                       asp-route-currentFilter="@Model.CurrentFilter"
                                       asp-route-searchString="@Model.CurrentFilter"
                                       asp-route-pageSize="@Model.PageSize">
                                        @Html.DisplayNameFor(model => model.PaginatedList[0].TestEnrollmentDate)
                                    </a>
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.PaginatedList[0].GovernmentId)
                                </th>


                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.PaginatedList)
                            {
                                <tr>
                                    <td>@item.LastName</td>
                                    <td>@item.FirstMidName</td>
                                    @if (item.TestEnrollmentDate != null)
                                    {
                                        <td>
                                            @item.TestEnrollmentDate.Value.ToString("d")
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            "No date"
                                        </td>
                                    }
                                    <td>@item.GovernmentIdFormatted</td>

                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info me-1">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

            </table>
        </div>


        <div class="d-flex justify-content-between align-items-center mt-3">
            <!-- PAGINATION -->
            <nav>
                <ul class="pagination mb-0">

                    <li class="page-item @(Model.PaginatedList.PageIndex == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-sortOrder="@Model.CurrentSort"
                           asp-route-pageIndex="1"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-searchString="@Model.CurrentFilter"
                           asp-route-pageSize="@Model.PageSize">
                            First
                        </a>
                    </li>

                    <li class="page-item @(Model.PaginatedList.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-sortOrder="@Model.CurrentSort"
                           asp-route-pageIndex="@(Model.PaginatedList.PageIndex - 1)"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-searchString="@Model.CurrentFilter"
                           asp-route-pageSize="@Model.PageSize">
                            Previous
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            Page @Model.PaginatedList.PageIndex of @Model.PaginatedList.TotalPages
                        </span>
                    </li>

                    <li class="page-item @(Model.PaginatedList.HasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-sortOrder="@Model.CurrentSort"
                           asp-route-pageIndex="@(Model.PaginatedList.PageIndex + 1)"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-searchString="@Model.CurrentFilter"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                        </a>
                    </li>

                    <li class="page-item
                            @(Model.PaginatedList.PageIndex == Model.PaginatedList.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-sortOrder="@Model.CurrentSort"
                           asp-route-pageIndex="@Model.PaginatedList.TotalPages"
                           asp-route-currentFilter="@Model.CurrentFilter"
                           asp-route-searchString="@Model.CurrentFilter"
                           asp-route-pageSize="@Model.PageSize">
                            Last
                        </a>
                    </li>

                </ul>
            </nav>

            <!-- Totals -->
            <div class="ms-3 text-muted">
                <i class="bi bi-bar-chart-fill me-1"></i>
                <b>@Model.PaginatedList.TotalRecords</b> record(s) total,
                <b>@Model.PaginatedList.FilteredCount</b> filtered,
                <b>@Model.PaginatedList.Count</b> visible
            </div>

        </div>

    }
    </div>
</div>
