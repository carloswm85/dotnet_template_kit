@using CleanArchitectureTemplate.ApplicationCore.Dtos.ContosoUniversity
@model TestStudentDto

@{
    ViewData["Title"] = "Create TestStudent";
}

<div class="card col-12 col-lg-9 mx-auto my-3">
    <div class="card-header pb-3">
        <h3 class="fw-normal my-3">
            <i class="bi bi-person-plus-fill me-2"></i>@ViewData["Title"]
        </h3>
    </div>

    <div class="card-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>

                <!-- Image Preview (Default or Existing) -->
                <div class="mb-3 text-center">
                    <img id="previewImage"
                        src="@(string.IsNullOrEmpty(Model?.ImagePath)
                            ? Url.Content("~/images/defaults/default-person.png")
                            : Url.Content(Model.ImagePath))"
                        alt="TestStudent profile"
                        class="img-thumbnail"
                        style="max-width: 150px;" />
                </div>

                <!-- Upload Image -->

                <!-- IMAGE -->
                <div class="mb-3">
                    <label asp-for="Image" class="form-label fw-semibold"></label>
                    <input asp-for="Image"
                           type="file"
                           class="form-control"
                           accept="image/*"
                           onchange="previewFile(event)" />
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>

                <!-- LAST_NAME -->
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label fw-semibold"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <!-- FIRST_MID_NAME -->
                <div class="mb-3">
                    <label asp-for="FirstMidName" class="form-label fw-semibold"></label>
                    <input asp-for="FirstMidName" class="form-control" />
                    <span asp-validation-for="FirstMidName" class="text-danger"></span>
                </div>

                <!-- GOVERNMENT_ID -->
                <div class="mb-3">
                    <label asp-for="GovernmentId" class="form-label fw-semibold"></label> (only numbers)
                    <input asp-for="GovernmentId" class="form-control" />
                    <span asp-validation-for="GovernmentId" class="text-danger"></span>
                </div>

                <!-- ENROLLMENT_DATE -->
                <div class="mb-3">
                    <label asp-for="TestEnrollmentDate" class="form-label fw-semibold"></label>
                    <input asp-for="TestEnrollmentDate" class="form-control" type="date" />
                    <span asp-validation-for="TestEnrollmentDate" class="text-danger"></span>
                </div>

                <hr />

                <!-- BUTTONS -->
                <div class="d-flex flex-column flex-md-row gap-2 pt-2">
                    <a asp-controller="ContosoUniversity"
                       asp-action="list"
                       class="btn btn-lg btn-outline-secondary flex-grow-1">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-lg btn-primary flex-grow-1">
                        <i class="bi bi-check-circle me-2"></i>Create
                    </button>
                </div>

            </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewFile(event) {
            const input = event.target;
            const preview = document.getElementById('previewImage');

            if (input.files && input.files[0]) {
                preview.src = URL.createObjectURL(input.files[0]);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const img = document.getElementById("previewImage");

            if (img) {
                img.addEventListener("error", function () {
                    this.src = '/images/defaults/default-person.png';
                });
            }
        });
    </script>
}
