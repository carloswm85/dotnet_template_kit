{
    "DetailedErrors": true,
    "ConnectionStrings": {
        // Local SQL Server with Windows authentication. Not used in Docker:
        // docker-compose passes the connection string from `.env`.
        "DefaultConnection": "Server=.;Database=CleanArchitectureTemplateDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft": "Information",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.EntityFrameworkCore": "Debug",
            "Microsoft.EntityFrameworkCore.Database.Command": "Information" // log SQL queries
        }
    },
    "ApiBaseUrl": "http://localhost:5018"
}