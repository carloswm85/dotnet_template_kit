{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "ApplicationName": "CleanArchitectureTemplate"
  },
  "JwtSettings": {
    // SecretKey, Issuer and Audience go in appsettings.{Environment}.json
    // or environment variables (JwtSettings__SecretKey, ...).
    "ExpirationMinutes": 60,
    // 7 days
    "RefreshTokenLifetimeMinutes": 10080
  },
  "Hosting": {
    // Sub-path when hosted behind a reverse proxy, e.g. "/apps/web". Empty = root.
    "PathBase": "",
    "ForwardedHeaders": {
      // Enable behind a reverse proxy so the app sees the client IP and scheme.
      "Enabled": false,
      // Proxy IPs to trust. Empty trusts any source: use only on a private network.
      "KnownProxies": []
    }
  },
  "RateLimiting": {
    // Per client IP, for login, register, password reset and token refresh.
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Swagger": {
    // Swagger UI and JSON. Leave "Enabled" unset to enable it only in
    // Development, or set "Enabled": true/false to override.
  }
}
