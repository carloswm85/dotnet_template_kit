{
  "$schema": "https://json.schemastore.org/template",
  "author": "Carlos W. Mercado",
  "classifications": [
    "Solution",
    "Web",
    "Monolith",
    "Simple",
    "ASP.NET"
  ],
  "identity": "Simple.Monolith.Template.CSharp",
  "groupIdentity": "Simple.Monolith.Template",
  "name": "DTK Simple Monolith Template (C#)",
  "shortName": "dtk-simple-monolith",
  "sourceName": "SimpleMonolithTemplate",
  "defaultName": "SimpleMonolithProject",
  "tags": {
    "language": "C#",
    "type": "solution",
    "platform": "web"
  },
  "preferNameDirectory": true,
  "description": "A simple solution template with monolith architecture.",
  "symbols": {
    "SolutionGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "11111111-1111-1111-1111-111111111111"
    },
    "TargetFramework": {
      "type": "parameter",
      "datatype": "choice",
      "replaces": "{{TargetFramework}}",
      "defaultValue": "net10.0",
      "choices": [
        {
          "displayName": ".NET 10.0 (LTS, Active)",
          "choice": "net10.0"
        }
      ],
      "description": "The target framework for the projects."
    },
    "IncludeDocumentation": {
      "type": "parameter",
      "description": "Include explanatory documentation",
      "datatype": "bool",
      "defaultValue": "false"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**",
        "**/.git/**",
        "**/.idea/**",
        "**/.vscode/**",
        "**/*.user",
        "**/*.suo",
        "**/.template.config/**",
        "**/*.cache"
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "./SimpleMonolithTemplate.slnx"
    }
  ],
  "postActions": [
    {
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "description": "Restore NuGet packages",
      "continueOnError": true,
      "args": {
        "files": "./SimpleMonolithTemplate.sln"
      },
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ]
    }
  ]
}
